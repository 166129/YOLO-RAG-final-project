# Copy to .env and adjust as needed. All values have working defaults.

# --- Artifacts built by notebooks/rag_pipeline.ipynb ---
VECTOR_STORE_PATH=data/vector_store
YOLO_WEIGHTS_PATH=models/signs_yolo.pt

# --- LLM (local Ollama) ---
LLM_MODEL=qwen2.5:7b-instruct
OLLAMA_HOST=http://localhost:11434
LLM_TEMPERATURE=0.0
LLM_NUM_PREDICT=400

# --- Retrieval ---
TOP_K=5
DETECTION_CONFIDENCE=0.25

# --- CORS: the frontend origin(s), comma separated ---
CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501

LOG_LEVEL=INFO
